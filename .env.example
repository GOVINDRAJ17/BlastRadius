# ==============================================================================
# BlastRadius 2.0 - Environment Configuration Template
# Copy this file to .env and configure your secrets locally.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core API & Service Settings (Phase 2 & 3)
# ------------------------------------------------------------------------------
NODE_ENV=production
API_PORT=4000
INSTANCE_ID=api-standalone
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,https://blastradius-dashboard.vercel.app,https://blastradius-dashboard-ctxdz9bwe.vercel.app

# Secret token required to authenticate POST /api/reports from GitHub Actions CI
REPORT_API_SECRET=your_long_random_report_ingestion_secret_here

# ------------------------------------------------------------------------------
# Redis Distributed Cache (Phase 2)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Cloud & Optional AWS Deployment (Phase 5 & 6 - Gated)
# Set CLOUD_DEPLOY_ENABLED=true only when AWS account is provisioned.
# ------------------------------------------------------------------------------
CLOUD_DEPLOY_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY_PREFIX=blastradius
ECS_CLUSTER_NAME=blastradius-cluster
ECS_SERVICE_NAME=blastradius-api-service

# ------------------------------------------------------------------------------
# Supabase Persistence (Phase 8)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://vjpbunykjtuixiprdaud.supabase.co
# Service role key (used ONLY server-side in API / GitHub Actions, never in frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Anonymous public key (read-only for dashboard client)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
CI_REPORT_SECRET=your_random_ci_report_secret_here
